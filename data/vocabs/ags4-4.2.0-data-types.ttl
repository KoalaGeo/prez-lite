    schema:status status:stable ;
.

agsdt:ID
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/data-types> ;
    skos:altLabel "ID"@en ;
    skos:definition """Unique Identifier. An ID is a unique identifier used across the project.
The ID shall be unique in the parent group but may be repeated in child groups i.e. SAMP (parent) vs ELRG (child), LOCA (parent) vs SAMP (child)."""@en ;
    skos:inScheme <https://w3id.org/ags4/voc/data-types> ;
    skos:notation "ID"^^xsd:token ;
    skos:prefLabel "Unique Identifier"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/data-types> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/data_types.json> ;
    schema:status status:stable ;
.

agsdt:MC
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/data-types> ;
    skos:altLabel "MC"@en ;
    skos:definition "British Standard BS1377 : Part 2 reported moisture content. This data type is included for legacy reasons and not used in AGS 4.2"@en ;
    skos:inScheme <https://w3id.org/ags4/voc/data-types> ;
    skos:notation "MC"^^xsd:token ;
    skos:prefLabel "British Standard BS1377 : Part 2 reported moisture content"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/data-types> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/data_types.json> ;
    schema:status status:stable ;
.

agsdt:PA
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/data-types> ;
    skos:altLabel "PA"@en ;
    skos:definition """Text listed in ABBR Group. Abbreviations listed in ABBR group. Rule 16 refers.
The list of standard abbreviations and descriptions are presented on the AGS website and shall not be redefined.
Other abbreviations may be defined as required within a project, but shall not match/impersonate existing standard abbreviations
e.g. "CP" for 'Cable percussion' in LOCA_TYPE shall not be given a non-standard abbreviation defined as "CH" for 'Cable hole'; likewise "SCP" (Static cone penetrometer) shall not be replaced by a non-standard abbreviation of "CPT" (Cone penetration test).
Multiple abbreviations can be used in a data VARIABLE. Where this occurs, abbreviations are joined using the concatenation character defined in TRAN_RCON (a "+" character by default)."""@en ;
    skos:inScheme <https://w3id.org/ags4/voc/data-types> ;
    skos:notation "PA"^^xsd:token ;
    skos:prefLabel "Text listed in ABBR Group"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/data-types> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/data_types.json> ;
    schema:status status:stable ;
.

