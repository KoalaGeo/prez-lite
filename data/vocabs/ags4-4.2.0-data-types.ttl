<https://w3id.org/ags4/voc/data-types>
    a skos:ConceptScheme ;
    dcterms:rights "Content of the AGS Data Format data dictionary (AGS 4.2.0), © Association of Geotechnical and Geoenvironmental Specialists (AGS). Reuse is subject to the AGS's terms; see https://www.ags.org.uk/data-format/. No licence is stated in the source repository." ;
    reg:status status:stable ;
    owl:versionIRI agsdt:4.2.0 ;
    owl:versionInfo "4.2.0" ;
    skos:definition "The data TYPEs of AGS 4.2.0. Generic types such as nDP are top concepts; the specific types used in the dictionary (e.g. 2DP) are narrower concepts."@en ;
    skos:hasTopConcept
        agsdt:DMS ,
        agsdt:DT ,
        agsdt:ID ,
        agsdt:MC ,
        agsdt:PA ,
        agsdt:PT ,
        agsdt:PU ,
        agsdt:RL ,
