    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/data-types> ;
    skos:altLabel "RL"@en ;
    skos:definition """Record Link. Rule 11 refers.
Text in specified format that refers to one or more records in other Groups by Key fields."""@en ;
    skos:inScheme <https://w3id.org/ags4/voc/data-types> ;
    skos:notation "RL"^^xsd:token ;
    skos:prefLabel "Record Link"@en ;
