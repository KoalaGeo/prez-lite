.

agsdt:U
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/data-types> ;
    skos:altLabel "U"@en ;
    skos:definition "Value with a variable format. This is used for fields that contain values with differing accuracy; e.g. AGS 4.1 = ELRG_RVAL (AGS 4.0 = ERES_RVAL)."@en ;
    skos:historyNote "data_types.json does not define U for AGS 4.2, but the dictionary uses it; definition taken from the entry for 4.1." ;
    skos:inScheme <https://w3id.org/ags4/voc/data-types> ;
    skos:notation "U"^^xsd:token ;
    skos:prefLabel "Value with a variable format"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/data-types> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/data_types.json> ;
    schema:status status:stable ;
.

agsdt:X
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/data-types> ;
    skos:altLabel "X"@en ;
    skos:definition "Text. Abbreviations used in text data are to be listed in ABBR group. Rule 16 refers."@en ;
    skos:inScheme <https://w3id.org/ags4/voc/data-types> ;
    skos:notation "X"^^xsd:token ;
    skos:prefLabel "Text"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/data-types> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/data_types.json> ;
    schema:status status:stable ;
.

agsdt:XN
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/data-types> ;
    skos:altLabel "XN"@en ;
    skos:definition """Text/numeric. There are some measured parameters that are typically numeric but can have a valid result that is text; examples include plastic limit (34 or NP) and depth of water in a borehole (2.34 or dry).
Abbreviations used in text data are to be listed in ABBR group. Rule 16 refers."""@en ;
    skos:inScheme <https://w3id.org/ags4/voc/data-types> ;
    skos:notation "XN"^^xsd:token ;
    skos:prefLabel "Text/numeric"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/data-types> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/data_types.json> ;
    schema:status status:stable ;
.

agsdt:YN
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/data-types> ;
    skos:altLabel "YN"@en ;
    skos:definition """Yes or No. Data in the file will be either a Y or N or Null (Rule 12)
e.g. Y"""@en ;
    skos:inScheme <https://w3id.org/ags4/voc/data-types> ;
    skos:notation "YN"^^xsd:token ;
    skos:prefLabel "Yes or No"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/data-types> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/data_types.json> ;
    schema:status status:stable ;
.

