    schema:status status:stable ;
.

agsdt:PU
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/data-types> ;
    skos:altLabel "PU"@en ;
    skos:definition """Text listed in UNIT Group. Abbreviations listed in UNIT group. Rule 15 refers.
The list of standard units and descriptions are presented on the AGS website and shall not be redefined.
This list is case sensitive."""@en ;
    skos:inScheme <https://w3id.org/ags4/voc/data-types> ;
    skos:notation "PU"^^xsd:token ;
    skos:prefLabel "Text listed in UNIT Group"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/data-types> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/data_types.json> ;
    schema:status status:stable ;
.

