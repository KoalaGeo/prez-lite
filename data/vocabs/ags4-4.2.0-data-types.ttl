    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/data-types> ;
    skos:altLabel "PT"@en ;
    skos:definition "Text listed in TYPE Group. Abbreviations listed in TYPE group. Rule 17 refers."@en ;
    skos:inScheme <https://w3id.org/ags4/voc/data-types> ;
    skos:notation "PT"^^xsd:token ;
    skos:prefLabel "Text listed in TYPE Group"@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/data-types> ;
