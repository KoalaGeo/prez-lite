agsunit:quantity-area
    a skos:Collection ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/units> ;
    skos:definition "AGS 4.2.0 units of area."@en ;
    skos:inScheme <https://w3id.org/ags4/voc/units> ;
    skos:member
        agsunit:acre ,
        agsunit:cm2 ,
        agsunit:ft2 ,
        agsunit:hect ,
        agsunit:in2 ,
        agsunit:km2 ,
        agsunit:m2 ,
        agsunit:mi2 ,
        agsunit:mm3 ,
        agsunit:yd2 ;
    skos:prefLabel "Area"@en ;
.

