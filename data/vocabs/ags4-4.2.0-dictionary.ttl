    skos:prefLabel "Hole Diameter by Depth"@en ;
    skos:scopeNote """HDIA describes the profile of final exploratory hole. Casing information for the final hole construction should be recorded in the CDIA group.
HDIA_REM allows additional information on the hole construction to be included in the data file as necessary."""@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/dictionary> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/4_2_0/groupsandheadings4-2-0.json> ;
