agsdict:LNMC
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/dictionary> ;
    skos:altLabel "LNMC"@en ;
    skos:definition "Water/moisture Content Tests"@en ;
    skos:inScheme <https://w3id.org/ags4/voc/dictionary> ;
    skos:narrower
        agsdict:FILE_FSET ,
        agsdict:LNMC_COMM ,
        agsdict:LNMC_CRED ,
