agsdict:SCPG
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/dictionary> ;
    skos:altLabel "SCPG"@en ;
    skos:definition "Static Cone Penetration Tests - General"@en ;
    skos:historyNote "Group status: DEPRECATED" ;
    skos:inScheme <https://w3id.org/ags4/voc/dictionary> ;
    skos:narrower
        agsdict:FILE_FSET ,
        agsdict:LOCA_ID ,
        agsdict:SCPG_CAR ,
        agsdict:SCPG_CONT ,
        agsdict:SCPG_CRED ,
        agsdict:SCPG_CSA ,
        agsdict:SCPG_ENV ,
        agsdict:SCPG_FILT ,
        agsdict:SCPG_FRIC ,
        agsdict:SCPG_METH ,
        agsdict:SCPG_OPER ,
        agsdict:SCPG_RATE ,
        agsdict:SCPG_REF ,
        agsdict:SCPG_REM ,
        agsdict:SCPG_SLAR ,
        agsdict:SCPG_TESN ,
        agsdict:SCPG_TYPE ,
        agsdict:SCPG_WAT ,
        agsdict:SCPG_WATA ;
    skos:notation "SCPG"^^xsd:token ;
    skos:prefLabel "Static Cone Penetration Tests - General"@en ;
    skos:scopeNote """SCPG is used to record the general information about static cone penetration tests.
Pressuremeter tests using CPT equipment (e.g. cone or driven pressuremeter) shall be recorded in the PMTG and associated groups.
SCPG_FILT and SCPG_FRIC are included as they are reporting requirements of BS1377 and BS EN ISO 22476-1.
SCPG_WATA is required to clarify origin of water level recorded in SCPG_WAT.
SCPG_REM is used to transfer comments on the test and any interpreted parameters. SCPG_REM may refer to the STND group where full information on standards and references could be provided.
CPT testing is frequently carried out by specialist sub-contractors. SCPG_CONT is included to record name of specialist sub-contractor.
SCPG_CAR and SCPG_SLAR are included to transfer information used to calculate qt and ft."""@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/dictionary> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/4_2_0/groupsandheadings4-2-0.json> ;
    schema:status status:deprecated ;
    agso:groupClass ags:SCPG ;
    agso:parentGroup agsdict:LOCA ;
.

