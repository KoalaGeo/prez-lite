    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/dictionary> ;
    skos:altLabel "PMTL"@en ;
    skos:definition "Pressuremeter Test Results - Individual Loops"@en ;
    skos:historyNote """AGS 4.1: Headings Added - PMTL_AXIS
AGS 4.2.0: Headings Added - Pressuremeter Test Results - Individual Loops; PMTL_HP, PMTL_HT, PMTL_CR""" ;
    skos:inScheme <https://w3id.org/ags4/voc/dictionary> ;
    skos:narrower
        agsdict:FILE_FSET ,
        agsdict:LOCA_ID ,
        agsdict:PMTG_DPTH ,
