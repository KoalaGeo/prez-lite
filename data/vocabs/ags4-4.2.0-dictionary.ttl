        agsdict:PMTL_AXIS ,
        agsdict:PMTL_CR ,
        agsdict:PMTL_GAA ,
        agsdict:PMTL_HP ,
        agsdict:PMTL_HT ,
        agsdict:PMTL_LNO ,
        agsdict:PMTL_NLSA ,
        agsdict:PMTL_NLSB ,
        agsdict:PMTL_PINC ,
        agsdict:PMTL_PRSA ,
        agsdict:PMTL_REM ,
        agsdict:PMTL_SINC ,
        agsdict:PMTL_STRA ;
    skos:notation "PMTL"^^xsd:token ;
    skos:prefLabel "Pressuremeter Test Results - Individual Loops"@en ;
    skos:scopeNote """PMTL is used to transfer summary details of test loops. If detailed information is required on test loop data this would be provided as attached files and listed under FILE_FSET in the PMTG group.
Additional headings PMTL_NLSA and PMTL_NLSB have been added to include for data from Bolton and Whittle s (1999) interpretation of unload-reload loops to derive non-linear stiffness parameters. The interpretation gives two parameters, sometimes referred to as the linearity exponent and shear stress coefficient (Beta and alpha respective).
PMTL_AXIS is used to report which arm combination has been used for analysis of the test loops in the same way as defined for PMTG_AXIS given above."""@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/dictionary> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/4_2_0/groupsandheadings4-2-0.json> ;
    schema:status status:stable ;
    agso:groupClass ags:PMTL ;
    agso:parentGroup agsdict:PMTG ;
.

