AGS 4.2.0: Headings Added - Cone Penetration Test (CPT/CPTu) - General; LOCA_ID, CPTG_TESN, CPTG_TYPE, CPTG_DATE, CPTG_PED, CPTG_RATE, CPTG_ORNT, CPTG_RLOC, CPTG_WAT, CPTG_WATA, CPTG_TERM, CPTG_REF, CPTG_MAN, CPTG_FILL, CPTG_CSA, CPTG_CSAN, CPTG_CAR, CPTG_SLA, CPTG_SLAN, CPTG_SHA, CPTG_SLAR, CPTG_CFOS, CPTG_CFOA, CPTG_TBL, CPTG_TBD, CPTG_CPC, CPTG_FPC, CPTG_UPC, CPTG_CPCL, CPTG_CRDT, CPTG_CDDT, CPTG_LCA, CPTG_FILT, CPTG_FRIC, CPTG_FRID, CPTG_FRIS, CPTG_SAT, CPTG_EQPT, CPTG_APCL, CPTG_DAZV, CPTG_CORR, CPTG_REM, CPTG_OPER, CPTG_ANBY, CPTG_ENV, CPTG_METH, CPTG_DEV, CPTG_CONT, CPTG_CRED, TEST_STAT, FILE_FSET""" ;
