agsdict:DOBS
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/dictionary> ;
    skos:altLabel "DOBS"@en ;
    skos:definition "Drilling/Advancement Observations & Parameters"@en ;
    skos:inScheme <https://w3id.org/ags4/voc/dictionary> ;
    skos:narrower
        agsdict:DOBS_BASE ,
