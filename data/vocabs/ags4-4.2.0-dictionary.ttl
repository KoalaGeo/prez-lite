agsdict:ABBR
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/dictionary> ;
    skos:altLabel "ABBR"@en ;
    skos:definition "Abbreviation Definitions"@en ;
    skos:historyNote "Group status: Required in all files (Rule 16)" ;
    skos:inScheme <https://w3id.org/ags4/voc/dictionary> ;
    skos:narrower
        agsdict:ABBR_CODE ,
        agsdict:ABBR_DESC ,
        agsdict:ABBR_HDNG ,
        agsdict:ABBR_LIST ,
        agsdict:ABBR_REM ,
        agsdict:FILE_FSET ;
    skos:notation "ABBR"^^xsd:token ;
    skos:prefLabel "Abbreviation Definitions"@en ;
    skos:scopeNote """ABBR is required in all AGS4 data files and describes all abbreviations used in headings defined by the PA data type (Rule 16).
The AGS Format website (www.agsdataformat.com) lists the standard abbreviations.
Additional abbreviations, used in any heading in the file, must be defined in this group.
ABBR_LIST details the list from which the ABBR_CODE originates. For standard AGS headings this value would be AGS4 to refer to the AGS website. For user-defined abbreviations, use the organisation identifier in ABBR_LIST."""@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/dictionary> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/4_2_0/groupsandheadings4-2-0.json> ;
    schema:status status:stable ;
    agso:groupClass ags:ABBR ;
.

agsdict:DETL
    a skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/ags4/voc/dictionary> ;
    skos:altLabel "DETL"@en ;
    skos:definition "Stratum Detail Descriptions"@en ;
    skos:inScheme <https://w3id.org/ags4/voc/dictionary> ;
    skos:narrower
        agsdict:DETL_BASE ,
        agsdict:DETL_DESC ,
        agsdict:DETL_REM ,
        agsdict:DETL_TOP ,
        agsdict:FILE_FSET ,
        agsdict:LOCA_ID ;
    skos:notation "DETL"^^xsd:token ;
    skos:prefLabel "Stratum Detail Descriptions"@en ;
    skos:scopeNote """DETL is used to include geological details to the geological description of a stratum typically included in the margins of a borehole log.
A geological description in DETL_DESC should be considered as a supplement to the main stratum description given in GEOL_DESC of the GEOL Group. Detailed descriptions should be given a single depth (which is repeated in both the DETL_TOP and DETL_BASE headings), only if it has no significant thickness, or if it marks the top of a gradational change in the nature of the stratum. For example, "27.65m Marl parting" or "35.65m Becoming very sandy". If the change in the stratum is not gradational it is generally preferable to give depth ranges. For example, "6.50 to 8.70m Sandy", is generally preferable to "Sandy below 6.50m". The depth or depth range of the detailed feature may be repeated within the description. Since the detailed descriptions are a supplement to the main description, detailed description depth ranges shall not cross main stratum boundaries."""@en ;
    skos:topConceptOf <https://w3id.org/ags4/voc/dictionary> ;
    prov:wasDerivedFrom <https://gitlab.com/AGS-DFWG-Web/ASG4/-/blob/710b1f08097264e6508be1397282aece79278fc4/AGS4/AGS4_2/4_2_0/groupsandheadings4-2-0.json> ;
    schema:status status:stable ;
    agso:groupClass ags:DETL ;
    agso:parentGroup agsdict:LOCA ;
.

