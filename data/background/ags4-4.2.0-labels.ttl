<https://w3id.org/ags4/ont>
    rdfs:label "AGS meta-model"@en ;
    schema:description "Format-level terms used to describe AGS groups, headings and records in RDF."@en ;
.

<https://w3id.org/ags4/ont/DataFile>
    rdfs:label "AGS data file"@en ;
    schema:description "An AGS data file converted to RDF."@en ;
.

<https://w3id.org/ags4/ont/FieldDefinition>
    rdfs:label "field definition"@en ;
    schema:description "The UNIT and TYPE a data file gives for one HEADING of one GROUP (AGS Rule 8). File values are typed using these, not the dictionary's suggested unit and type."@en ;
.

<https://w3id.org/ags4/ont/Record>
    rdfs:label "Record"@en ;
    schema:description "A DATA row of an AGS GROUP. Each group's class is a subclass."@en ;
.

<https://w3id.org/ags4/ont/abbreviationList>
    rdfs:label "abbreviation list"@en ;
    schema:description "The collection of standard abbreviations for a heading of type PA."@en ;
.

<https://w3id.org/ags4/ont/agsVersion>
    rdfs:label "AGS version"@en ;
    schema:description "The AGS edition a data file declares in TRAN_AGS."@en ;
.

<https://w3id.org/ags4/ont/dataFile>
    rdfs:label "data file"@en ;
    schema:description "The AGS data file a record was read from."@en ;
.

<https://w3id.org/ags4/ont/dataType>
    rdfs:label "data type"@en ;
    schema:description "The suggested AGS data TYPE of a heading (a concept in the data types vocabulary)."@en ;
.

<https://w3id.org/ags4/ont/dictionaryEntry>
    rdfs:label "dictionary entry"@en ;
    schema:description "Links an OWL class, OWL property or SHACL shape to the concept describing it in the AGS dictionary vocabulary."@en ;
.

<https://w3id.org/ags4/ont/field>
    rdfs:label "field"@en ;
    schema:description "A field definition of a data file."@en ;
.

<https://w3id.org/ags4/ont/group>
    rdfs:label "group"@en ;
    schema:description "The group class a field definition belongs to."@en ;
.

<https://w3id.org/ags4/ont/groupClass>
    rdfs:label "group class"@en ;
    schema:description "Links a group concept in the dictionary vocabulary to the OWL class of its records."@en ;
.

<https://w3id.org/ags4/ont/heading>
    rdfs:label "heading"@en ;
    schema:description "The heading concept an abbreviation (or abbreviation list) belongs to."@en ;
.

<https://w3id.org/ags4/ont/headingStatus>
    rdfs:label "heading status"@en ;
    schema:description "The raw AGS heading status: '*' (KEY), 'R' (REQUIRED), '*R' (both) or '' (OTHER)."@en ;
.

<https://w3id.org/ags4/ont/isKey>
    rdfs:label "is key"@en ;
    schema:description "True if the heading is a KEY field in the group (Rule 10a)."@en ;
.

<https://w3id.org/ags4/ont/isRequired>
    rdfs:label "is required"@en ;
    schema:description "True if the heading is a REQUIRED field in the group (Rule 10b)."@en ;
.

<https://w3id.org/ags4/ont/parent>
    rdfs:label "parent record"@en ;
    schema:description "Links a record to the record in its PARENT GROUP whose KEY fields it shares (AGS Rule 10c)."@en ;
.

<https://w3id.org/ags4/ont/parentGroup>
    rdfs:label "parent group"@en ;
    schema:description "The PARENT GROUP of a group (between group classes or group concepts)."@en ;
.

<https://w3id.org/ags4/ont/position>
    rdfs:label "position"@en ;
    schema:description "Position of a heading in a group's HEADING row."@en ;
.

<https://w3id.org/ags4/ont/property>
    rdfs:label "heading property"@en ;
    schema:description "The OWL property used for a heading's values (from a heading concept or a field definition)."@en ;
.

<https://w3id.org/ags4/ont/rule>
    rdfs:label "rule"@en ;
    schema:description "An AGS rule (concept in the rules vocabulary) a shape implements."@en ;
.

<https://w3id.org/ags4/ont/suggestedUnit>
    rdfs:label "suggested unit"@en ;
    schema:description "The suggested AGS UNIT of a heading (a concept in the units vocabulary, or a literal when the unit is not in the standard UNIT list)."@en ;
.

<https://w3id.org/ags4/ont/type>
    rdfs:label "type"@en ;
    schema:description "The TYPE declared in a data file (a data types concept, or a literal)."@en ;
.

<https://w3id.org/ags4/ont/unit>
    rdfs:label "unit"@en ;
    schema:description "The UNIT declared in a data file (a units concept, or a literal for non-standard units)."@en ;
.

<https://w3id.org/ags4/ont/userDefined>
    rdfs:label "user defined"@en ;
    schema:description "True for a group or heading not in the AGS dictionary (defined in the file's DICT group, Rule 18)."@en ;
.

