<https://w3id.org/ags4/voc/contaminant-codes> a skos:ConceptScheme;
    skos:definition "Codes for chemical contaminants and determinands used in ELRG_CODE (AGS 4.1 onwards) and ERES_CODE (AGS 4.0). Only entries with status Approved, Accepted, Deprecated are included."@en;
