    ],
    "https://prez.dev/label": [
      {
        "@value": "Rule 11c",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Any heading of data TYPE 'Record Link' included in a data file shall cross-reference to the KEY FIELDs of data rows in the GROUP referred to by the heading contents.",
        "@language": "en"
      }
    ]
