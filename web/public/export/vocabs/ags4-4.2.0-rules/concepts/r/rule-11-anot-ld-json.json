    "https://prez.dev/label": [
      {
        "@value": "Rule 11a",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Each GROUP/KEY FIELD shall be separated by a delimiter character. This single delimiter character shall be defined in TRAN_DLIM. The default being \"|\" (ASCII character 124).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ags4/voc/rules/rule-11b",
    "https://prez.dev/identifier": [
