        "@value": "ns1:rule-10a"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:gswa-vocabs/collections/ns1:rules/items/ns1:rule-10a"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Rule 10a",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "In every GROUP, certain HEADINGs are defined as KEY. There shall not be more than one row of data in each GROUP with the same combination of KEY field entries. KEY fields must appear in each GROUP, but may contain null data (see Rule 12).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ags4/voc/rules/rule-10b",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:rule-10b"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:gswa-vocabs/collections/ns1:rules/items/ns1:rule-10b"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Rule 10b",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Some HEADINGs are marked as REQUIRED. REQUIRED fields must appear in the data GROUPs where they are indicated in the AGS FORMAT DATA DICTIONARY. These fields require data entry and cannot be null (i.e. left blank or empty).",
        "@language": "en"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ags4/voc/rules/rule-10c",
    "https://prez.dev/identifier": [
      {
        "@value": "ns1:rule-10c"
      }
    ],
    "https://prez.dev/link": [
      {
        "@value": "/catalogs/catalogue:gswa-vocabs/collections/ns1:rules/items/ns1:rule-10c"
      }
    ],
    "https://prez.dev/label": [
      {
        "@value": "Rule 10c",
        "@language": "en"
      }
    ],
    "https://prez.dev/description": [
      {
        "@value": "Links are made between data rows in GROUPs by the KEY fields. Every entry made in the KEY fields in any GROUP must have an equivalent entry in its PARENT GROUP. The PARENT GROUP must be included within the data file.",
        "@language": "en"
      }
    ]
  }
